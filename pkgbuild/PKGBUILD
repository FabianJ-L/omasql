pkgname=sqlite-lens
pkgver=0.1.0
pkgrel=1
pkgdesc='A light SQLite client with completion, a schema browser, and a row inspector'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'sqlite' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/sqlite-lens "$pkgdir/usr/bin/sqlite-lens"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/sqlite-lens.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sqlite-lens.svg"
  install -Dm644 "$startdir/sqlite-lens.desktop" "$pkgdir/usr/share/applications/sqlite-lens.desktop"
}
