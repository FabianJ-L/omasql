pkgname=omasql
pkgver=0.4.0
pkgrel=1
pkgdesc='A light SQLite client with completion, a schema browser, and a row inspector'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'sqlite' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()
# Links oma-update, the updater every Oma app ships.
install=oma-apps.install

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omasql "$pkgdir/usr/bin/omasql"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omasql.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omasql.svg"
  install -Dm644 "$startdir/omasql.desktop" "$pkgdir/usr/share/applications/omasql.desktop"
  # oma-update and where this build came from, so it can update the app later.
  install -Dm755 "$startdir/oma-update" "$pkgdir/usr/share/oma-apps/$pkgname/oma-update"
  printf 'REPO=%s\nCOMMIT=%s\n' "https://github.com/FabianJ-L/$pkgname" \
    "$(git -C "$startdir/.." rev-parse HEAD 2>/dev/null)" |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/oma-apps/$pkgname/source"
}
