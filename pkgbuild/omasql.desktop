[Desktop Entry]
Type=Application
Name=Omasql
GenericName=SQLite Database Browser
Comment=Query and browse SQLite databases
Comment[de]=SQLite-Datenbanken abfragen und durchsehen
Exec=omasql %f
Icon=omasql
Terminal=false
Categories=Development;Database;
MimeType=application/vnd.sqlite3;application/x-sqlite3;
Keywords=sqlite;sql;database;query;db;browser;table;
StartupWMClass=omasql
